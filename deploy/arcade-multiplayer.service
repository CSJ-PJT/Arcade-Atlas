[Unit]
Description=Arcade Atlas multiplayer room service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arcade
Group=arcade
WorkingDirectory=/opt/arcade-atlas
Environment=NODE_ENV=production
Environment=ARCADE_HOST=127.0.0.1
Environment=ARCADE_PORT=4188
Environment=ARCADE_ALLOWED_ORIGINS=https://161.33.17.84
Environment=ARCADE_STATE_FILE=/var/lib/arcade-atlas/rooms.json
StateDirectory=arcade-atlas
StateDirectoryMode=0700
ExecStart=/usr/bin/node --import tsx /opt/arcade-atlas/server/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
NoNewPrivileges=true
UMask=0077
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
MemoryMax=128M
TasksMax=64
LimitNOFILE=1024
RemoveIPC=true

[Install]
WantedBy=multi-user.target
