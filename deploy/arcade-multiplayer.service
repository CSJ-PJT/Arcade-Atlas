[Unit]
Description=Arcade Atlas multiplayer room service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arcade
Group=arcade
WorkingDirectory=/opt/arcade-atlas
Environment=NODE_ENV=production
Environment=ARCADE_HOST=127.0.0.1
Environment=ARCADE_PORT=4188
Environment=ARCADE_ALLOWED_ORIGINS=https://161.33.17.84
Environment=ARCADE_STATE_FILE=/var/lib/arcade-atlas/rooms.json
StateDirectory=arcade-atlas
StateDirectoryMode=0700
ExecStart=/usr/bin/node /opt/arcade-atlas/server/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
